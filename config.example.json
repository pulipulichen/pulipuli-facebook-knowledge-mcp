{
  "project": "pulipuli-blog-knowledge-mcp",
  "source": {
    "id": "pulipuli-blog",
    "homepage": "https://blog.pulipuli.info/",
    "feed_urls": [
      "https://blog.pulipuli.info/feeds/posts/default"
    ],
    "backfill": {
      "enabled": true,
      "strategy": "blogger-atom-pagination"
    }
  },
  "ingestion": {
    "executor": "github-actions-node-runner",
    "embedding_transport": "worker-single-text-proxy",
    "interval_days": 2,
    "max_articles_per_request": 1,
    "feed_page_size": 100,
    "concurrency": 1,
    "request_delay_ms": 1000,
    "retry_failed_articles": true
  },
  "storage": {
    "metadata": "cloudflare-d1",
    "vectors": "qdrant-cloud"
  },
  "embedding": {
    "provider": "cloudflare-workers-ai",
    "model": "@cf/baai/bge-m3",
    "dimensions": null,
    "dimension_strategy": "detected-from-first-embedding",
    "chunk_size_chars": 900,
    "chunk_overlap_chars": 150
  },
  "search": {
    "default_mode": "hybrid",
    "max_results": 20,
    "keyword_strategy": "substring-search-for-Chinese-text",
    "hybrid_ranking": "reciprocal-rank-fusion"
  },
  "mcp": {
    "transport": "streamable-http",
    "path": "/mcp",
    "read_only": true,
    "tools": ["search_articles", "get_article"]
  }
}

